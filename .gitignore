*.egg

# Ignore dist/ inside subdirectories (Python build artifacts) but NOT at root
backend/dist/
frontend/dist-ssr/

# Explicitly track compiled frontend assets at repo root
!index.html
!_redirects
!assets/

# Node / Frontend
frontend/node_modules/
*.log
npm-debug.log*

# IDE & OS
.vscode/
.idea/
.DS_Store
*.swp
*.swo

# Ignore any root-level requirements.txt (accidentally generated via pip freeze)
# The actual project backend requirements live at backend/requirements.txt
/requirements.txt
