# ==============================================================================
# BhoomiStack — Example Environment Configuration
# Copy this file to .env and adjust variables as needed
# ==============================================================================

# Backend API Configuration
DATABASE_URL=sqlite:///./bhoomistack.db
SECRET_KEY=replace-with-your-secure-32-byte-hex-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend Configuration
VITE_API_BASE_URL=/api/v1
VITE_MAP_STYLE=https://demotiles.maplibre.org/style.json
FRONTEND_PORT=5173
