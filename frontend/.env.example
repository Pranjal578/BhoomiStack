# BhoomiStack Frontend Configuration Template
# Copy this to .env and fill in your values
# NEVER commit .env to version control

# API Base URL (proxied through Vite/nginx to backend)
VITE_API_BASE_URL=/api/v1

# Map style URL (open tile endpoint for development)
VITE_MAP_STYLE=https://demotiles.maplibre.org/style.json

# CARTO API Key (if using CARTO basemaps — keep out of frontend bundle in prod!)
# For production, use a tile proxy on your backend instead of exposing this key
VITE_CARTO_API_KEY=your_carto_api_key_here

# Google Analytics Measurement ID (optional, for analytics integration)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
